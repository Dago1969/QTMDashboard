<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ChangeSet che elimina le tabelle geography se esistono: utile per pulizia DB. -->
    <changeSet id="20260915-01-drop-geography" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <or>
                <tableExists tableName="city"/>
                <tableExists tableName="province"/>
                <tableExists tableName="region"/>
            </or>
        </preConditions>

        <dropTable tableName="city" cascadeConstraints="true"/>
        <dropTable tableName="province" cascadeConstraints="true"/>
        <dropTable tableName="region" cascadeConstraints="true"/>
    </changeSet>

</databaseChangeLog>
