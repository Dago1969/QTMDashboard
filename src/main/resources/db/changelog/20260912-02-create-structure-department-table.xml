<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260912-02-create-structure-department-table" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="structure_department"/>
            </not>
        </preConditions>

        <createTable tableName="structure_department">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codice_struttura" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="codice_disciplina" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="referents_json" type="VARCHAR(8000)" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="structure_department"
            columnNames="codice_struttura,codice_disciplina"
            constraintName="uk_structure_department_key"/>

        <rollback>
            <dropTable tableName="structure_department"/>
        </rollback>
    </changeSet>
</databaseChangeLog>