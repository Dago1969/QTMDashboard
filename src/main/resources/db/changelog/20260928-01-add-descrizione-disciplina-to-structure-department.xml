<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20260928-01-add-descrizione-disciplina-to-structure-department" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="structure_department" columnName="descrizione_disciplina"/>
            </not>
        </preConditions>
        <addColumn tableName="structure_department">
            <column name="descrizione_disciplina" type="VARCHAR(255)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="structure_department" columnName="descrizione_disciplina"/>
        </rollback>
    </changeSet>
</databaseChangeLog>