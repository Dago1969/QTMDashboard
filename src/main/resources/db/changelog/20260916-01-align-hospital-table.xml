<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260916-01-add-codice-regione" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="hospital"/>
                <not><columnExists tableName="hospital" columnName="codice_regione"/></not>
            </and>
        </preConditions>
        <addColumn tableName="hospital">
            <column name="codice_regione" type="VARCHAR(50)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="hospital" columnName="codice_regione"/>
        </rollback>
    </changeSet>

