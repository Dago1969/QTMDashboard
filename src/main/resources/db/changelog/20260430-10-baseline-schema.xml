    <changeSet id="20260430-10-add-patients-gender-check" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="patients"/>
            <columnExists tableName="patients" columnName="gender"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM information_schema.table_constraints
                WHERE constraint_schema = DATABASE()
                  AND table_name = 'patients'
                  AND constraint_name = 'chk_patients_gender_mf'
            </sqlCheck>
        </preConditions>
        <sql>
            ALTER TABLE patients
            ADD CONSTRAINT chk_patients_gender_mf
            CHECK (gender IS NULL OR gender IN ('M', 'F'))
        </sql>
    </changeSet>

</databaseChangeLog>