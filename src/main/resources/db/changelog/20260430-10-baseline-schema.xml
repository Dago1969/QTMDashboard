            <column name="region_id" type="BIGINT"/>
            <column name="region" type="VARCHAR(255)"/>
            <column name="province_id" type="BIGINT"/>
            <column name="province" type="VARCHAR(255)"/>
            <column name="city_id" type="BIGINT"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="delivery_address" type="VARCHAR(1000)"/>
            <column name="secondary_addresses" type="VARCHAR(2000)"/>
            <column name="communication_channels" type="VARCHAR(1000)"/>
            <column name="identification_document_reference" type="VARCHAR(2000)"/>
            <column name="data_processing_consent" type="BOOLEAN"/>
            <column name="data_processing_consent_datetime" type="TIMESTAMP"/>
            <column name="data_processing_consent_revocation_log" type="VARCHAR(4000)"/>
            <column name="additional_consents" type="VARCHAR(2000)"/>
            <column name="therapy_status" type="VARCHAR(255)"/>
            <column name="prescribing_specialist" type="VARCHAR(255)"/>
            <column name="reference_hospital_structure" type="VARCHAR(255)"/>
            <column name="reference_pharmacy" type="VARCHAR(255)"/>
            <column name="preferred_pickup_pharmacy" type="VARCHAR(255)"/>
            <column name="delivery_mode" type="VARCHAR(255)"/>
