<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261008-01-add-medicine-tenant-visibility" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="medicines" columnName="visible_for_tenants"/>
            </not>
        </preConditions>
        <addColumn tableName="medicines">
            <column name="visible_for_tenants" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="medicines" columnName="visible_for_tenants"/>
        </rollback>
    </changeSet>
</databaseChangeLog>